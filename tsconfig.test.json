{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": false,
    "outDir": ".tmp-tests",
    "rootDir": "."
  },
  "include": [
    "src/hooks/useAppPreferences.ts",
    "src/i18n/uiText.ts",
    "src/editor/types.ts",
    "src/editor/layout.ts",
    "src/editor/state.ts",
    "src/editor/domain/**/*.ts",
    "src/persistence/saveCoordinator.ts",
    "src/app/keyboard/types.ts",
    "src/app/keyboard/foldChord.ts",
    "src/app/keyboard/resolveKeyboardCommand.ts",
    "src/features/jump/model.ts",
    "src/features/search/model.ts",
    "src/features/organizer/**/*.ts"
  ]
}
